    "_meta": {
        "purpose": "Storage-layout zero-diff baseline for the Perimeter lending-side security perimeter.",
        "baseRef": "83871cd0 (\"add how-to integration docs\") — the upstream base of sovryn-perimeter-fee, i.e. the layout the LIVE mainnet sovrynProtocol and iToken proxies hold today.",
        "capturedOn": "2026-08-02",
        "solc": "0.5.17+commit.d19bba13 (optimizer enabled, runs 200 — hardhat.config.js)",
        "normalization": "solc storageLayout entries reduced to {label, slot, offset, type}, sorted by slot/offset/label, with AST node-id suffixes after a \")\" stripped from type strings (they shift with the compilation set and are not a layout change).",
        "groups": {
            "protocol": "Storage of contracts/core/State.sol — the layout every module registered on the sovrynProtocol proxy delegatecalls into.",
            "iTokenBeacon": "Storage of the iToken logic chain (LoanTokenBase → AdvancedTokenStorage → LoanTokenLogicStorage) — the layout every beacon logic contract delegatecalls into inside an iToken proxy."
        },
        "newContractsNote": "ExitFeeModule and BorrowerExitPerimeterOps do not exist at the base ref; they are Perimeter additions that run by delegatecall in the protocol proxy. Their baseline is therefore the base-ref protocol layout itself — the invariant is that they add no state to the live proxy.",
        "regenerate": "Only on an INTENTIONAL, reviewed layout change. See the header of tests/perimeter/StorageLayout.zerodiff.test.js.",
        "consumers": [
            "tests/perimeter/StorageLayout.zerodiff.test.js",
            "tests/perimeter/utils/storageLayout.js"
        ]
    },
